#: translation:10
msgid "Welcome to OpenMandriva"
msgstr "Добро пожаловать в OpenMandriva"

#: translation:11
msgid "OpenMandriva Welcome"
msgstr "OpenMandriva Welcome"

#: translation:13
msgid "Welcome"
msgstr "Приветствие"

#: translation:14
msgid "Features"
msgstr "Возможности"

#: translation:15
msgid "OM Features"
msgstr "Возможности OM"

